# ─── Copia este fichero a .env.local para desarrollo ─────────────────────────
# En producción, estas variables se ponen en:
#   Vercel → Project → Settings → Environment Variables
#
# Ojo: en Vite, TODO lo que empiece por VITE_ acaba dentro del JavaScript
# que se descarga el navegador. No pongas aquí ningún secreto de verdad
# (la clave anon de Supabase sí es pública por diseño; la service_role NO
# debe aparecer nunca en este proyecto).

# ─── Sentry ──────────────────────────────────────────────────────────────────
# El DSN que da Sentry al crear el proyecto (plataforma: React).
# Si se deja vacío, Sentry queda desactivado y la app funciona igual.
VITE_SENTRY_DSN=

# Opcionales:
# Nombre del entorno con el que se agrupan los errores en Sentry.
VITE_SENTRY_ENV=production
# Para saber qué versión del código falló. En Vercel se puede poner el
# valor del sistema: $VERCEL_GIT_COMMIT_SHA
VITE_APP_RELEASE=

# ─── Supabase ────────────────────────────────────────────────────────────────
# Normalmente NO hace falta tocarlas: si no están, se usan los valores de
# producción que ya vienen en src/supabase.js. Los tests automáticos las
# usan para apuntar a un Supabase de mentira en local.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
